{
  "name": "sistema-tickets",
  "version": "1.0.0",
  "description": "Sistema de tickets con Bun y Vite",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bun run dev:backend\" \"bun run dev:frontend\"",
    "dev:backend": "bun --watch Backend/server.js",
    "dev:frontend": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "bun Backend/server.js",
    "test": "bun test",
    "test:performance": "bun test Backend/tests/performance.test.ts",
    "test:api": "bun test Backend/tests/api.test.ts",
    "test:load": "bun test Backend/tests/load.test.ts",
    "test:simple": "bun run Backend/tests/simple-test.ts",
    "benchmark": "bun run Backend/tests/benchmark.ts"
  },
  "keywords": [
    "tickets",
    "bun",
    "vite"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mongoose": "^8.0.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.1",
    "concurrently": "^8.2.2",
    "vite": "^5.0.0"
  }
}
