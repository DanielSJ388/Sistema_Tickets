{
  "compilerOptions": {
    // Type checking
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    
    // Module resolution
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "lib": ["ESNext"],
    "types": ["bun-types"],
    
    // Interop
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    
    // Output
    "skipLibCheck": true,
    "allowJs": true,
    "outDir": "./dist",
    
    // Bun specific
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": [
    "Backend/**/*.ts",
    "Backend/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "uploads"
  ]
}
